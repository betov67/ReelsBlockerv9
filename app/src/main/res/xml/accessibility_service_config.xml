<?xml version="1.0" encoding="utf-8"?>
<!--
  Declarative configuration for ReelsBlockerAccessibilityService.

  Scoped tightly to Instagram only (android:packageNames) and to the two
  event types the service actually needs, so the system never even delivers
  events for other apps or other interaction types to us.

  typeWindowContentChanged is deliberately NOT requested. v9/v10 subscribed
  to it for screen classification, but Instagram fires it constantly while
  a Reel simply plays (caption text, like-count, progress bar), which was
  misread as "the user left the Clips player" far more often than intended.
  v11 classifies screens only on typeWindowStateChanged, which fires on
  genuine screen/window transitions, not minor content ticks.

  flagReportViewIds is required: without it, AccessibilityNodeInfo#getViewIdResourceName()
  returns null for every node, and every identifier match in
  com.reelsblocker.app.util.Constants depends on view ids being populated.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.instagram.android" />
