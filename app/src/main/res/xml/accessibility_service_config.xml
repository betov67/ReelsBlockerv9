<?xml version="1.0" encoding="utf-8"?>
<!--
  Declarative configuration for ReelsBlockerAccessibilityService.

  Scoped tightly to Instagram only (android:packageNames) and to the three
  event types the service actually needs, so the system never even delivers
  events for other apps or other interaction types to us.

  flagReportViewIds is required: without it, AccessibilityNodeInfo#getViewIdResourceName()
  returns null for every node, and every identifier match in
  com.reelsblocker.app.util.Constants depends on view ids being populated.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.instagram.android" />
